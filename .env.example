# Copy to .env and fill in your credentials.
# NEVER commit .env — it contains secrets.

# ─── KIS (한국투자증권) credentials ──────────────────────────────────
# Get these from https://apiportal.koreainvestment.com after registering an app.
# Create TWO apps — one for the mock (모의투자) server and one for live — and
# use the mock app key first while you test.
KIS_APP_KEY=
KIS_APP_SECRET=

# Account, either combined …
KIS_ACCOUNT=12345678-01     # CANO-ACNT_PRDT_CD format
# … or as separate parts (used only if KIS_ACCOUNT is blank):
# KIS_ACCOUNT_NO=12345678
# KIS_PRODUCT_CODE=01

# ─── Server selection ───────────────────────────────────────────────
# By default the server is chosen by the --mock flag:
#   --mock  -> https://openapivts.koreainvestment.com:29443  (paper / fake money)
#   (none)  -> https://openapi.koreainvestment.com:9443      (LIVE / real money)
# Only set KIS_BASE_URL to override that default (advanced). If you set it,
# make sure it matches your --mock choice, since --mock also selects the
# paper vs. live transaction IDs.
# KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# ─── backtest.co.kr (optional, external data source) ────────────────
# Only used by the legacy `kis-passive-trader fetch` command. The primary
# workflow is to download a portfolio JSON file and pass it with --portfolio.
# KRXDATA_API_URL=https://backtest.co.kr
# KRXDATA_TOKEN=

# ─── Legacy `kis-passive-trader execute` guardrails (not used by patient_maker) ─
# MAX_ORDER_KRW=5000000
# MAX_SESSION_MINUTES=30
